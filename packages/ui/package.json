    "prettier": "prettier --write --ignore-unknown ."
  },
  "dependencies": {
    "@heroui/theme": "2.4.26"
  },
  "peerDependencies": {
    "@heroui/react": "^2.8.10",
    "framer-motion": "^12.43.0",
