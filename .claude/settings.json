{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run build:*)",
      "Bash(npm run proto:*)",
      "Bash(npx prisma generate:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.docker)",
      "Read(./chess_backend/deploy/k8s/secrets.env)"
    ]
  }
}
