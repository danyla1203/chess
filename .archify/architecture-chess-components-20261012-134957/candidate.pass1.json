  "cards": [
    { "dot": "cyan", "title": "After a command reaches game-svc", "items": [
      "GameCommandHandler maps the AMQP type to a GameService method; in-game commands first check the caller is a player",
      "GameService calls GameRepository.update(id, mutate): load snapshot → Game.fromSnapshot → mutate → Lua CAS save, retried on version conflict",
      "Mutations run on the Game aggregate; moves go through GameProcess (validation, check, mate)",
      "GameAdapter turns the Game into DTOs; the reply goes back to core over direct reply-to",
      "core GameGateway emits the result to user:/game: rooms via SocketNotifier"
    ] },
    { "dot": "violet", "title": "Async side effects", "items": [
      "active → ended: the same Lua save XADDs a GameEndedEvent to {chess}:outbox",
      "OutboxRelay publishes it to game.lifecycle; GameHistoryConsumer saves it to Postgres if both players are authorized",
      "GameClock (leader only) emits timeTick every 1 s and ends timed-out games via endByTimeout"
    ] },
    { "dot": "emerald", "title": "core business relations", "items": [
      "UserService.create → AuthService.createSession on signup",
      "Stripe webhook → PaymentsService → UserService.topUpBalance",
      "Socket handshake: ConnectionPatchProvider → TokenService / AuthService",
      "IsBalanceEnough guard → BalanceModel → Postgres user balance"
    ] },
    { "dot": "amber", "title": "Shared infrastructure", "items": [
      "Redis in core: Socket.IO adapter, HTTP cache (Keyv)",
      "RabbitMQService: confirmed publish, retry with backoff, 5 attempts then chess.dlx",
      "OTel SDK (traces, metrics, logs), winston logger, /health/live + /health/ready"
    ] }
  ]
